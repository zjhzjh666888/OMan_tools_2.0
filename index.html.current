<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>omale-tools</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f4f7f5;
      --surface: rgba(255, 255, 255, 0.92);
      --surface-soft: #f8faf8;
      --text: #18221d;
      --muted: #6f7974;
      --line: #e0e8e3;
      --brand: #2f8b57;
      --brand-strong: #236b43;
      --brand-soft: #e8f5ed;
      --brand-glow: rgba(47, 139, 87, 0.18);
      --accent: #1473e6;
      --shadow: 0 8px 24px rgba(30, 53, 41, 0.06);
      --shadow-soft: 0 12px 32px rgba(30, 53, 41, 0.1);
      --motion: 200ms;
      --radius-lg: 22px;
      --radius-md: 14px;
      --sidebar-width: 220px;
      --font-heading: 'Montserrat', 'Inter', 'PingFang SC', sans-serif;
      --font-body: 'Inter', 'PingFang SC', sans-serif;
      --font-family: var(--font-body);
    }
    [data-theme="dark"] {
      --bg: #000000;
      --surface: rgba(18, 20, 30, 0.35);
      --surface-soft: rgba(22, 24, 36, 0.3);
      --text: #e8eaf0;
      --muted: #9ba3b0;
      --line: rgba(80, 90, 120, 0.3);
      --brand: #34a853;
      --brand-strong: #2d8f47;
      --brand-soft: rgba(52, 168, 83, 0.1);
      --brand-glow: rgba(52, 168, 83, 0.15);
      --accent: #4285f4;
      --shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      --shadow-soft: 0 10px 26px rgba(0, 0, 0, 0.35);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100vh; }
    body {
      font-family: var(--font-family);
      color: var(--text);
      background: var(--bg);
    }
    [data-theme="light"] body {
      background: linear-gradient(160deg, #f0f7f2 0%, #f7f4f0 40%, #f2f5fa 100%);
      background-attachment: fixed;
    }

    /* 顶部滚动公告 */
    .announcement-bar {
      width: 100%;
      background: transparent;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      padding: 6px 0;
      overflow: hidden;
      white-space: nowrap;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
    }
    [data-theme="light"] .announcement-bar {
      background: linear-gradient(90deg, var(--brand), var(--brand-strong));
    }
    .announcement-bar .marquee {
      display: inline-block;
      animation: marquee 40s linear infinite;
      padding-left: 100%;
    }
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }

    /* 右上角操作栏 */
    .top-right-actions {
      position: fixed;
      top: 36px;
      right: 24px;
      z-index: 9998;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .top-right-actions .theme-toggle {
      width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 50%;
      background: var(--surface); color: var(--text); font-size: 16px; cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: all .2s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .top-right-actions .theme-toggle:hover { border-color: var(--brand); }
    .top-right-actions .logout-btn {
      padding: 6px 14px; border: 1px solid var(--line); border-radius: 8px;
      background: var(--surface); color: var(--muted); font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all .2s; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .top-right-actions .logout-btn:hover { border-color: var(--brand); color: var(--brand); }

    /* 深色模式粒子画布 */
    #dark-particle-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -1;
      pointer-events: none;
    }

    /* 整体布局 */
    .app-layout {
      display: flex;
      min-height: 100vh;
      padding-top: 30px;
    }

    /* 侧边栏 */
    .sidebar {
      width: var(--sidebar-width);
      min-height: calc(100vh - 30px);
      background: linear-gradient(to left, transparent, var(--surface) 30%);
      border-right: none;
      position: fixed;
      top: 30px;
      left: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      padding: 20px 0;
      overflow-y: auto;
      z-index: 100;
    }
    .sidebar-brand {
      padding: 0 16px 20px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 12px;
    }
    .sidebar-brand h1 {
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 800;
      color: var(--brand);
      cursor: pointer;
      margin-bottom: 4px;
      line-height: 1.4;
    }
    .sidebar-brand p {
      font-size: 11px;
      color: var(--muted);
      line-height: 1.4;
    }
    .sidebar-nav {
      flex: 1;
      padding: 0 10px;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      margin-bottom: 4px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      transition: all var(--motion) ease;
      cursor: pointer;
    }
    .sidebar-link:hover {
      background: var(--brand-soft);
      color: var(--brand-strong);
    }
    .sidebar-link.router-link-active,
    .sidebar-link.active {
      background: var(--brand);
      color: #fff !important;
      box-shadow: 0 4px 12px rgba(47, 139, 87, 0.25);
    }
    .sidebar-link .nav-icon {
      font-size: 18px;
      width: 22px;
      text-align: center;
    }
    .sidebar-footer {
      padding: 8px 12px 8px;
      transform: translateY(14px);
      border-top: 1px solid var(--line);
      margin-top: auto;
    }
    .user-avatar {
      width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 2px solid var(--brand); flex-shrink: 0;
    }
    .user-avatar-placeholder {
      width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .user-nickname {
      font-size: 13px; font-weight: 600; color: var(--text); max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* 主内容区 */
    .main-content {
      margin-left: var(--sidebar-width);
      flex: 1;
      padding: 24px 32px 48px;
      min-height: calc(100vh - 30px);
    }

    /* 卡片网格 */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
    .card {
      display: block; text-decoration: none; color: var(--text);
      border: 1px solid var(--line); border-radius: 18px; background: var(--surface);
      backdrop-filter: blur(8px);
      padding: 20px; min-height: 140px; cursor: pointer;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease, background .25s ease;
      position: relative; overflow: hidden;
    }
    [data-theme="light"] .card {
      box-shadow: 0 2px 12px rgba(30, 53, 41, 0.04);
      transition: transform .3s cubic-bezier(.4,0,.2,1), box-shadow .3s cubic-bezier(.4,0,.2,1), border-color .3s ease, background .3s ease;
    }
    [data-theme="light"] .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--brand), var(--accent));
      opacity: 0;
      transition: opacity .3s ease;
      border-radius: 18px 18px 0 0;
    }
    [data-theme="light"] .card:hover::before {
      opacity: 1;
    }
    [data-theme="light"] .card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 16px 40px rgba(47, 139, 87, 0.12), 0 6px 16px rgba(20, 115, 230, 0.08);
      border-color: var(--brand);
      background: linear-gradient(135deg, rgba(47,139,87,0.05), rgba(20,115,230,0.04));
    }
    [data-theme="light"] .card:active {
      transform: translateY(-2px) scale(0.98);
      box-shadow: 0 0 0 3px rgba(47, 139, 87, 0.3), 0 0 20px rgba(47, 139, 87, 0.2), 0 0 40px rgba(20, 115, 230, 0.1);
    }
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 0 20px rgba(52, 168, 83, 0.15), var(--shadow-soft);
      border-color: var(--brand);
    }
    [data-theme="light"] .card:hover {
      transform: translateY(-6px) scale(1.02);
    }
    [data-theme="dark"] .card {
      border-color: rgba(80, 90, 120, 0.2);
      background: rgba(15, 18, 28, 0.25);
      backdrop-filter: blur(6px);
    }
    [data-theme="dark"] .card:hover {
      background: rgba(20, 40, 35, 0.55);
      border-color: rgba(52, 168, 83, 0.5);
      box-shadow: 0 0 24px rgba(52, 168, 83, 0.12), 0 8px 32px rgba(0,0,0,0.3);
    }
    .card:hover .name { color: var(--brand); }
    .name { font-size: 17px; font-weight: 650; color: var(--text); transition: color .2s; margin: 0; }
    .desc { margin: 8px 0 0; font-size: 13px; color: var(--muted); line-height: 1.6; }
    .meta { margin-top: 14px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .tag { border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; background: var(--surface-soft); color: var(--muted); font-size: 11px; font-weight: 650; }
    .card:hover .tag { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
    .domain { color: var(--muted); font-size: 11px; margin-left: auto; }
    .card-header { display: flex; align-items: center; margin-bottom: 4px; }
    .card-favicon { width: 22px; height: 22px; border-radius: 5px; margin-right: 10px; object-fit: contain; }
    .card-favicon-fallback { width: 22px; height: 22px; border-radius: 5px; margin-right: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; color: #fff; }
    .emoji-icon { margin-right: 8px; font-size: 16px; }

    .star-btn {
      margin-left: 4px; border: 1px solid var(--line); background: var(--surface); color: var(--muted);
      border-radius: 999px; padding: 3px 9px; display: inline-flex; align-items: center; gap: 4px;
      cursor: pointer; font-size: 11px; font-weight: 700; transition: all .2s;
    }
    .star-btn:hover { border-color: var(--brand); }

    /* 游客模式：隐藏收藏按钮 */
    [data-guest="true"] .star-btn { display: none !important; }
    .star-btn.starred { color: #b45309; border-color: rgba(245,158,11,0.35); background: rgba(245,158,11,0.1); }



    /* 个人中心弹出菜单 */
    .user-popup-wrapper {
      position: relative;
    }
    .user-popup-trigger {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 8px;
      border-radius: 8px;
      cursor: pointer;
      transition: background .15s;
    }
    .user-popup-wrapper:hover .user-popup-trigger {
      background: rgba(47,139,87,0.10);
    }
    .share-row {
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 0 8px 8px;
      font-size: 11px;
      color: var(--muted);
    }
    .share-row .share-hint {
      flex: 1;
      font-size: 11px;
      color: var(--muted);
      line-height: 1.4;
    }
    .share-copy-btn {
      padding: 3px 10px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: transparent;
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all .15s;
      font-family: inherit;
    }
    .share-copy-btn:hover {
      border-color: var(--brand);
      color: var(--brand);
      background: var(--brand-soft);
    }
    .share-copy-btn.copied {
      border-color: #30a46c;
      color: #30a46c;
      background: rgba(48,164,108,0.1);
    }
    .user-popup-menu {
      position: absolute;
      bottom: 100%;
      left: 0;
      right: 0;
      margin-bottom: 6px;
      background: var(--surface);
      border-radius: 12px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.15), 0 0 0 1px rgba(0,0,0,0.06);
      padding: 6px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(6px);
      transition: opacity .15s, visibility .15s, transform .15s;
    }
    .user-popup-wrapper:hover .user-popup-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .menu-item {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 12px;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--text);
      font-size: 13px;
      font-family: inherit;
      cursor: pointer;
      transition: background .15s;
      text-align: left;
    }
    .menu-item:hover {
      background: var(--surface-soft);
    }
    .menu-item .menu-icon {
      width: 22px;
      text-align: center;
      font-size: 14px;
      flex-shrink: 0;
    }
    .menu-divider {
      height: 1px;
      background: var(--line);
      margin: 4px 8px;
    }
    .menu-item.danger {
      color: #e5484d;
    }
    .menu-item.danger:hover {
      background: rgba(229,72,77,0.08);
    }

    /* 弹窗 */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-card {
      background: var(--surface);
      border-radius: 14px;
      padding: 24px;
      width: 360px;
      max-width: 90vw;
      box-shadow: 0 8px 40px rgba(0,0,0,0.2);
    }
    .modal-card h3 {
      margin: 0 0 16px;
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
    }
    .modal-card input[type="text"] {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      background: var(--surface-soft);
      color: var(--text);
      outline: none;
      box-sizing: border-box;
    }
    .modal-card input[type="text"]:focus {
      border-color: var(--brand);
    }
    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 16px;
    }
    .btn-primary {
      padding: 8px 20px;
      border: none;
      border-radius: 8px;
      background: var(--brand);
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
    }
    .btn-primary:hover { opacity: 0.9; }
    .btn-cancel {
      padding: 8px 20px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: transparent;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      font-family: inherit;
    }
    .btn-cancel:hover { background: var(--surface-soft); }
    .modal-hint {
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
    }
    .modal-success {
      color: #30a46c;
      font-size: 12px;
      margin-top: 6px;
      font-weight: 600;
    }
    .modal-error {
      color: #e5484d;
      font-size: 12px;
      margin-top: 6px;
    }
    .avatar-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin: 12px 0;
    }
    .avatar-item {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color .15s;
    }
    .avatar-item:hover { border-color: var(--brand); }
    .avatar-item.active { border-color: var(--brand); }
    .upload-zone {
      border: 2px dashed var(--line);
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: border-color .15s, background .15s;
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 12px;
    }
    .upload-zone:hover {
      border-color: var(--brand);
      background: var(--surface-soft);
    }
    .modal-section-title {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      margin: 12px 0 6px;
      text-transform: uppercase;
    }
    .qr-image {
      display: block;
      margin: 12px auto 0;
      max-width: 200px;
      border-radius: 8px;
    }
    [v-cloak] { display: none; }
    .page-title { margin: 0 0 16px; font-family: var(--font-heading); font-size: 28px; font-weight: 800; color: var(--brand); }
    .page-desc { margin: 0 0 20px; font-size: 14px; color: var(--muted); }
    .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); padding: 4px 0 10px; }
    .breadcrumb-title { font-family: var(--font-heading); font-size: 18px; font-weight: 800; color: var(--brand); }
    .breadcrumb a { color: var(--brand); text-decoration: none; font-weight: 600; }

    .category-title {
      margin: 0 0 14px; font-size: 18px; font-weight: 800; color: var(--brand-strong);
      padding: 8px 12px; border-left: 4px solid var(--brand); border-radius: 10px;
      background: linear-gradient(90deg, rgba(47,139,87,0.08), transparent);
    }

    .tag-filter { margin: 16px 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .filter-label { font-size: 13px; color: var(--muted); font-weight: 500; }
    .tag-btn { padding: 5px 11px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--text); font-size: 12px; cursor: pointer; transition: all .2s; }
    .tag-btn:hover { border-color: var(--brand); color: var(--brand); }
    .tag-btn.active { background: var(--brand); color: white; border-color: var(--brand); }

    /* 付费弹窗 */
    .pay-modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 10000;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(4px);
    }
    .pay-modal {
      background: var(--surface); border-radius: 20px; padding: 32px; max-width: 400px; width: 90%;
      text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    .pay-modal h3 { font-size: 20px; font-weight: 700; color: var(--brand); margin-bottom: 12px; }
    .pay-modal p { font-size: 14px; color: var(--muted); transform: translateY(14px); line-height: 1.6; }
    .pay-modal .qrcode-img { width: 200px; height: 200px; border-radius: 12px; border: 2px solid var(--line); margin: 0 auto 16px; display: block; object-fit: contain; background: #fff; }
    .pay-modal .pay-info { font-size: 12px; color: var(--muted); transform: translateY(14px); line-height: 1.8; }
    .pay-modal .pay-info strong { color: var(--text); }
    .pay-modal .btn-row { display: flex; gap: 10px; justify-content: center; }
    .pay-modal .btn-close {
      padding: 8px 20px; border: 1px solid var(--line); border-radius: 10px;
      background: transparent; color: var(--muted); font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .pay-modal .btn-close:hover { border-color: var(--brand); color: var(--brand); }
    .pay-modal .btn-paid {
      padding: 8px 20px; border: none; border-radius: 10px;
      background: var(--brand); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .pay-modal .btn-paid:hover { background: var(--brand-strong); }

    /* 反馈区 */
    .feedback-section { margin-top: 48px; background: var(--brand-soft); border: 1px solid rgba(47,139,87,0.15); border-radius: 18px; padding: 28px; display: flex; gap: 20px; align-items: flex-start; }
    [data-theme="dark"] .feedback-section {
      background: rgba(15, 20, 30, 0.4);
      border-color: rgba(52, 168, 83, 0.15);
      backdrop-filter: blur(6px);
    }
    .feedback-left { flex: 1; min-width: 0; }
    .feedback-right { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; align-self: center; }
    .feedback-right img { width: 220px; height: 220px; border-radius: 14px; border: 2px solid var(--line); object-fit: contain; background: #fff; }
    .feedback-right p { font-size: 12px; color: var(--muted); text-align: center; line-height: 1.6; max-width: 200px; }
    @media (max-width: 768px) {
      .feedback-section { flex-direction: column; }
      .feedback-right { align-self: center; }
    }
    .feedback-title { margin: 0 0 10px; font-size: 20px; font-weight: 700; color: var(--brand); }
    .feedback-desc { margin: 0 0 16px; font-size: 13px; color: var(--muted); line-height: 1.6; }
    .feedback-form { display: flex; flex-direction: column; gap: 10px; max-width: 560px; }
    .feedback-input, .contact-input {
      width: 100%; border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
      padding: 10px 14px; color: var(--text); outline: none; font-size: 13px; font-family: inherit;
      transition: border-color .2s;
    }
    .feedback-input { min-height: 100px; resize: vertical; }
    .contact-input { height: 42px; }
    .feedback-input:focus, .contact-input:focus { border-color: var(--brand); }
    .feedback-submit {
      height: 42px; padding: 0 24px; border: 0; border-radius: 12px; background: var(--brand);
      color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all .2s; align-self: flex-start;
    }
    .feedback-submit:hover { background: var(--brand-strong); }
    .feedback-submit:disabled { opacity: 0.5; cursor: not-allowed; }

    .send-status { margin-top: 12px; padding: 6px 14px; border-radius: 20px; font-weight: 500; font-size: 13px; display: inline-block; }
    .success-msg { background: rgba(47,139,87,0.1); color: var(--brand); }
    .error-msg { background: rgba(229,72,47,0.1); color: #e5482f; }
    .info-msg { background: rgba(59,130,246,0.1); color: #3b82f6; }

    /* 响应式 */
    @media (max-width: 768px) {
      .sidebar { width: 60px; padding: 12px 0; }
      .sidebar-brand h1 { font-size: 14px; padding: 0 8px; }
      .sidebar-brand p, .sidebar-link span:not(.nav-icon), .sidebar-footer { display: none; }
      .sidebar-link { justify-content: center; padding: 10px; }
      .sidebar-link .nav-icon { margin: 0; }
      .main-content { margin-left: 60px; padding: 16px; }
      .grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .card { min-height: 120px; padding: 14px; }
    }
  </style>
</head>
<body data-theme="light">


<div id="app" v-cloak>
  <!-- 深色模式粒子画布 -->
  <canvas id="dark-particle-canvas"></canvas>

  <!-- 右上角操作栏 -->
  <div class="top-right-actions">
    <button v-if="currentUser && !isGuest" @click="$router.push('/favorites')" class="logout-btn" style="display:flex;align-items:center;gap:4px;"><span style="font-size:16px;">🏠</span>我的收藏夹</button>
    <button @click="showNotice=true" class="theme-toggle" title="公告"><span>📢</span></button>
    <button @click="toggleDarkMode" class="theme-toggle">
      <span v-if="isDarkMode">🌞</span><span v-else>🌙</span>
    </button>
  </div>

  <!-- 顶部滚动公告 -->
  <div class="announcement-bar">
    <span class="marquee">支付成功后联系站长QQ邮箱：2477099183@qq.com &nbsp;&nbsp;&nbsp;&nbsp; 支付成功后联系站长QQ邮箱：2477099183@qq.com &nbsp;&nbsp;&nbsp;&nbsp; 支付成功后联系站长QQ邮箱：2477099183@qq.com</span>
  </div>

  <div class="app-layout">
    <!-- 左侧侧边栏 -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <h1 @click="$router.push('/')">{{ currentUser ? '你好' + currentUser.nickname + '开心呀' : 'omale-tools' }}</h1>
        <p>WavePeak | AI效率导航</p>
      </div>
      <nav class="sidebar-nav">
        <router-link to="/" class="sidebar-link"><span class="nav-icon">🏠</span><span>首页</span></router-link>
        <router-link to="/ai-nav" class="sidebar-link"><span class="nav-icon">🧭</span><span>AI导航站</span></router-link>
        <router-link to="/ai-tools" class="sidebar-link"><span class="nav-icon">🛠️</span><span>AI工具</span></router-link>
        <router-link to="/media-tools" class="sidebar-link"><span class="nav-icon">🎨</span><span>办公/媒体</span></router-link>
        <router-link to="/study" class="sidebar-link"><span class="nav-icon">📚</span><span>学习</span></router-link>
        <router-link to="/free-vip" class="sidebar-link"><span class="nav-icon">🎁</span><span>白嫖会员</span></router-link>
        <router-link to="/paid-api" class="sidebar-link"><span class="nav-icon">🔑</span><span>AI聚合站</span></router-link>
      </nav>
      <div class="sidebar-footer" v-if="currentUser && !isGuest">
        <div class="user-popup-wrapper">
          <div class="user-popup-trigger">
            <img v-if="currentUser.avatar" :src="currentUser.avatar" class="user-avatar" />
            <span v-else class="user-avatar-placeholder">{{ currentUser.nickname?.slice(0,1) || '?' }}</span>
            <span class="user-nickname">{{ currentUser.nickname }}</span>
          </div>
          <div class="share-row">
            <span class="share-hint">分享本站给朋友，一起发掘宝藏</span>
            <button class="share-copy-btn" :class="{copied: shareCopied}" @click.stop="copyShareLink">{{ shareCopied ? '已复制链接' : '复制链接 →' }}</button>
          </div>
          <div class="user-popup-menu" @click.stop>
            <button class="menu-item" @click="showNicknameModal=true;newNickname=currentUser.nickname">
              <span class="menu-icon">✏️</span>修改昵称
            </button>
            <button class="menu-item" @click="openAvatarModal">
              <span class="menu-icon">🖼️</span>修改头像
            </button>
            <div class="menu-divider"></div>
            <button class="menu-item" @click="showQrModal=true">
              <span class="menu-icon">👥</span>加入资料社区
            </button>
            <div class="menu-divider"></div>
            <button class="menu-item danger" @click="logout">
              <span class="menu-icon">🚪</span>退出登录
            </button>
          </div>
        </div>
      </div>
    </aside>

    <!-- 主内容 -->
    <main class="main-content">
      <div style="margin-bottom:20px;position:relative;max-width:480px;">
        <input v-model="searchQuery" type="text" placeholder="搜索工具名称、描述..." style="width:100%;height:42px;padding:0 40px 0 14px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--text);font-size:14px;outline:none;transition:border-color .2s;box-shadow:0 2px 8px rgba(0,0,0,0.04);" @focus="$event.target.style.borderColor='var(--brand)'" @blur="$event.target.style.borderColor='var(--line)'" />
        <span style="position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:16px;color:var(--muted);pointer-events:none;">🔍</span>
      </div>
      <div v-if="searchQuery.trim()" style="margin-bottom:24px;">
        <p style="font-size:13px;color:var(--muted);margin-bottom:12px;">搜索结果：找到 {{ searchResults.length }} 个工具</p>
        <div class="grid">
          <a v-for="item in searchResults" :key="item.id" :href="item.url" target="_blank" class="card">
            <div class="card-header">
              <img v-if="!item.__faviconFailed" :src="getFaviconUrl(item.domain||item.url)" class="card-favicon" @error="handleFaviconError($event,item)"/>
              <div v-else class="card-favicon-fallback" :style="{background:getSiteColor(item)}">{{ (item.name||'?')[0] }}</div>
              <h3 class="name">{{item.name}}</h3>
            </div>
            <p class="desc">{{item.desc}}</p>
            <div class="meta">
              <span class="tag">{{item.tag}}</span>
              <span class="domain">{{item.domain}}</span>
            </div>
          </a>
        </div>
        <p v-if="searchResults.length===0" style="color:var(--muted);font-size:13px;text-align:center;padding:20px 0;">没有找到匹配的工具</p>
      </div>
      <router-view v-show="!searchQuery.trim()"></router-view>

      <section class="feedback-section">
        <div class="feedback-left">
          <h2 class="feedback-title">征集更多好用的工具</h2>
          <p class="feedback-desc">发现好工具？推荐给我们，让更多人受益。可发送至：<strong>2477099183@qq.com</strong></p>
          <div class="feedback-form">
            <input v-model="contactInfo" class="contact-input" type="text" placeholder="您的联系方式（邮箱/微信号）*" />
            <textarea v-model="feedbackText" class="feedback-input" placeholder="工具名称、功能描述、访问链接..." rows="3"></textarea>
            <button @click="submitFeedback" class="feedback-submit" :disabled="isSending || isSubmitDisabled" type="button">
              {{ isSending ? '发送中...' : isSubmitDisabled ? '请稍后再提交' : '提交推荐' }}
            </button>
          </div>
          <div v-if="sendMessage" class="send-status" :class="sendStatusClass">{{ sendMessage }}</div>
        </div>
        <div class="feedback-right">
          <img src="assets/wechat-pay-qr.png" alt="微信收款码" />
          <p>觉得对你有帮助就资助一下吧，每一分都是更新下去的动力</p>
        </div>
      </section>
    </main>
  </div>

  <!-- 公告弹窗 -->
  <div v-if="showNotice" class="pay-modal-overlay" @click.self="closeNotice">
    <div class="pay-modal" style="max-width:420px;">
      <h3 style="font-family:'Montserrat','PingFang SC',sans-serif;font-size:23px;font-weight:700;background:linear-gradient(135deg,#6366f1,#a855f7,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-align:center;margin-bottom:10px;">关注是元满啊</h3>
      <p style="font-size:13px;color:var(--muted);text-align:center;margin-bottom:22px;line-height:1.6;">想一起学习 · 免费领取宝藏资料可进微信群</p>
      <div style="text-align:center;margin-bottom:22px;">
        <img src="qrcode_mp.png?v=1" alt="公众号二维码" style="max-width:100%;display:inline-block;" />
        <p style="font-size:12px;color:var(--muted);margin-top:12px;letter-spacing:2px;">长按识别二维码 · 关注公众号</p>
      </div>
      <a href="https://space.bilibili.com/3537112108370749" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:20px;padding:12px 20px;background:rgba(0,161,214,0.06);border:1px solid rgba(0,161,214,0.18);border-radius:12px;text-decoration:none;transition:all 0.2s;">
        <span style="font-size:18px;">📺</span>
        <span style="font-size:13px;color:var(--text);">B站主页：</span>
        <span style="color:#00a1d6;font-weight:600;font-size:13px;">是元满啊</span>
        <span style="color:#00a1d6;font-size:12px;margin-left:auto;">→</span>
      </a>
      <label style="display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:16px;font-size:12px;color:var(--muted);cursor:pointer;">
        <input type="checkbox" v-model="noticeDontShow" style="width:14px;height:14px;cursor:pointer;" />
        下次不再自动弹出
      </label>
      <div class="btn-row">
        <button class="btn-paid" @click="closeNotice">我知道了</button>
      </div>
    </div>
  </div>

  <!-- 付费弹窗 -->

  <!-- 修改昵称弹窗 -->
  <div v-if="showNicknameModal" class="modal-overlay" @click.self="showNicknameModal=false">
    <div class="modal-card">
      <h3>修改昵称</h3>
      
      <input type="text" v-model="newNickname" maxlength="20" placeholder="输入新昵称（2-20个字符）" @keyup.enter="updateNickname" />
      <p v-if="nicknameMsg" class="modal-success">{{ nicknameMsg }}</p>
      <p v-if="nicknameErr" class="modal-error">{{ nicknameErr }}</p>
      <div class="modal-actions">
        <button class="btn-cancel" @click="showNicknameModal=false">取消</button>
        <button class="btn-primary" @click="updateNickname">确认修改</button>
      </div>
    </div>
  </div>

  <!-- 修改头像弹窗 -->
  <div v-if="showAvatarModal" class="modal-overlay" @click.self="closeAvatarModal">
    <div class="modal-card">
      <h3>修改头像</h3>
      <div class="upload-zone" @click="$refs.avatarFile.click()">
        <input ref="avatarFile" type="file" accept="image/*" style="display:none" @change="handleAvatarFile" />
        <template v-if="!uploadingAvatar">点击上传自定义头像</template>
        <template v-else>上传中...</template>
      </div>
      <p class="modal-hint">支持 JPG/PNG，不超过 2MB</p>
      <p class="modal-section-title">或选择预设头像</p>
      <div class="avatar-grid">
        <img v-for="av in presetAvatars" :key="av" :src="av" @click="selectPresetAvatar(av)" class="avatar-item" :class="{active: selectedPreset === av}" />
      </div>
      <p v-if="avatarMsg" class="modal-success">{{ avatarMsg }}</p>
      <p v-if="avatarErr" class="modal-error">{{ avatarErr }}</p>
      <div class="modal-actions">
        <button class="btn-cancel" @click="closeAvatarModal">关闭</button>
      </div>
    </div>
  </div>

  <!-- 加入资料社区二维码弹窗 -->
  <div v-if="showQrModal" class="modal-overlay" @click.self="showQrModal=false">
    <div class="modal-card">
      <h3>加入资料分享社区</h3>
      <img src="qr-community.png" class="qr-image" alt="社区二维码" />
      <p class="modal-hint" style="text-align:center;">该二维码7天内(8月15日前)有效，重新进入将更新</p>
      <div class="modal-actions" style="justify-content:center;">
        <button class="btn-cancel" @click="showQrModal=false">关闭</button>
      </div>
    </div>
  </div>

  <div v-if="showPayModal" class="pay-modal-overlay" @click.self="showPayModal=false">
    <div class="pay-modal">
      <h3>🔑 AI聚合站</h3>
      <p>1元即可解锁免费的AI聚合站</p>
      <img src="assets/wechat-pay-qr.png" alt="微信收款码" class="qrcode-img" />
      <div class="pay-info">
        <p>💰 价格：<strong>1元</strong></p>
        <p>📱 扫码微信支付后，填写微信信息并提交开通申请</p>
        <p>⏰ 站长收到后会尽快为您开通权限</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
        <input v-model="paidWechatName" type="text" placeholder="您的微信昵称 *" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;background:var(--surface-soft);color:var(--text);outline:none;" />
        <input v-model="paidWechatId" type="text" placeholder="您的微信号 *" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;font-size:13px;background:var(--surface-soft);color:var(--text);outline:none;" />
      </div>
      <div class="btn-row">
        <button class="btn-close" @click="showPayModal=false">取消</button>
        <button class="btn-paid" @click="handlePaidConfirm" :disabled="paidSubmitting">{{ paidSubmitting ? '提交中...' : '我已支付，申请开通' }}</button>
      </div>
      <div v-if="paidMsg" style="margin-top:12px;font-size:13px;" :style="{color: paidMsgOk ? '#2f8b57' : '#e5482f'}">{{ paidMsg }}</div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
<script src="https://unpkg.com/vue-router@4/dist/vue-router.global.prod.js"></script>


<script>
  const { createApp, ref, computed, onMounted } = Vue;
  const { createRouter, createWebHashHistory } = VueRouter;

  const normalizeDomain = (domainOrUrl) => {
    if (!domainOrUrl) return '';
    try { return new URL(domainOrUrl).hostname.replace(/^www\./, ''); } catch {}
    return String(domainOrUrl).trim().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];
  };

  const getFaviconUrl = (domainOrUrl) => {
    const domain = normalizeDomain(domainOrUrl);
    if (!domain) return '';
    return `https://icons.duckduckgo.com/ip3/${domain}.ico`;
  };

  const hashString = (str) => { let h = 0; for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) >>> 0; return h; };
  const getSiteColor = (item) => {
    const h = hashString(item?.domain || item?.url || item?.id || '');
    const palette = ['#2f8b57','#1473e6','#7c3aed','#db2777','#ea580c','#0ea5e9','#16a34a','#b91c1c','#9333ea','#0f766e','#c026d3','#2563eb'];
    return palette[h % palette.length];
  };

  const handleFaviconError = (event, item) => {
    const img = event?.target;
    if (!img) return;
    img.style.display = 'none';
    if (item) item.__faviconFailed = true;
  };

  const getCategoryEmoji = (title) => {
    const m = { 'AI导航站':'🧭','AI工具':'🛠️','办公/媒体工具':'🎨','学习资源':'📚','白嫖APP会员':'🎁','AI简历':'📄','AI论文':'📝','AI办公':'💼','AI提示词':'💬','AI学习助手':'🎓','AI视频':'🎥','办公工具':'📁','图片工具':'🖼️','视频工具':'🎬','音乐工具':'🎵','AI聚合站':'🔑' };
    return m[title] || '✨';
  };

  // ========== EmailJS 已移除，改用后端 Resend ==========

  // ========== 后端 API ==========
  const API_BASE = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
    ? `${location.protocol}//${location.hostname}:3000`
    : '/otools';

  // ========== 全局状态 ==========
  const globalTools = ref([]);
  const currentUser = ref(null);
  const isGuest = ref(false);
  const userStarredSet = ref(new Set());

  const getToken = () => localStorage.getItem('token');
  const authHeaders = () => {
    const token = getToken();
    return token ? { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json' };
  };

  const checkAuth = () => {
    const token = getToken();
    const userStr = localStorage.getItem('user');
    if (!token || !userStr) { window.location.href = 'login.html'; return false; }
    try { currentUser.value = JSON.parse(userStr); } catch { window.location.href = 'login.html'; return false; }
    return true;
  };

  const logout = () => { localStorage.removeItem('token'); localStorage.removeItem('user'); window.location.href = 'login.html'; };
  const shareCopied = ref(false);
  const copyShareLink = async () => {
    try {
      await navigator.clipboard.writeText('https://omaleai.qzz.io/otools/login.html');
      shareCopied.value = true;
      setTimeout(() => { shareCopied.value = false; }, 2000);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = 'https://omaleai.qzz.io/otools/login.html';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      shareCopied.value = true;
      setTimeout(() => { shareCopied.value = false; }, 2000);
    }
  };
  const isStarred = (tool) => userStarredSet.value.has(tool?.id);

  const syncStarsFromBackend = async () => {
    try {
      const resp = await fetch(`${API_BASE}/api/stars`);
      if (!resp.ok) return;
      const data = await resp.json();
      const map = data.stars || {};
      globalTools.value = globalTools.value.map(t => ({ ...t, stars_count: map[t.id] || t.stars_count || 0 }));
    } catch {}
  };

  const loadMyStars = async () => {
    const token = getToken();
    if (!token) return;
    try {
      const resp = await fetch(`${API_BASE}/api/my-stars`, { headers: authHeaders() });
      if (!resp.ok) return;
      const data = await resp.json();
      userStarredSet.value = new Set(data.starred || []);
    } catch {}
  };

  const sendMessage = ref('');
  const sendStatusClass = ref('');
  const setUiMessage = (msg, cls = 'info-msg', ms = 2600) => {
    sendMessage.value = msg; sendStatusClass.value = cls;
    if (ms) setTimeout(() => (sendMessage.value = ''), ms);
  };

  const starLocks = new Set();
  const handleStar = async (tool) => {
    if (!tool?.id || starLocks.has(tool.id)) return;
    const token = getToken();
    if (!token) { setUiMessage('请先登录后再点赞', 'error-msg'); setTimeout(() => { window.location.href = 'login.html'; }, 1200); return; }
    const starred = isStarred(tool);
    const prev = tool.stars_count || 0;
    // Optimistic UI toggle
    if (starred) {
      tool.stars_count = Math.max(prev - 1, 0);
      userStarredSet.value.delete(tool.id);
    } else {
      tool.stars_count = prev + 1;
      userStarredSet.value.add(tool.id);
    }
    starLocks.add(tool.id);
    try {
      const resp = await fetch(`${API_BASE}/api/star`, { method: starred ? 'DELETE' : 'POST', headers: authHeaders(), body: JSON.stringify({ tool_id: tool.id }) });
      const data = await resp.json();
      if (!resp.ok) { if (resp.status === 401) { setUiMessage('登录过期，请重新登录', 'error-msg'); setTimeout(() => { window.location.href = 'login.html'; }, 1200); } throw new Error(data.error); }
      tool.stars_count = data.stars_count;
    } catch {
      // Rollback on failure
      tool.stars_count = prev;
      if (starred) { userStarredSet.value.add(tool.id); } else { userStarredSet.value.delete(tool.id); }
    } finally {
      starLocks.delete(tool.id);
    }
  };

  // ========== 页面组件 ==========
  const Home = {
    template: `<div><h1 class="page-title">omale-tools</h1><p class="page-desc">精选高效AI工具与实用资源，一键直达</p><div class="grid"><div class="card" @click="$router.push('/ai-nav')"><h3 class="name"><span class="emoji-icon">🧭</span>AI导航站</h3><p class="desc">主流AI工具导航聚合平台</p></div><div class="card" @click="$router.push('/ai-tools')"><h3 class="name"><span class="emoji-icon">🛠️</span>AI工具</h3><p class="desc">简历、论文、办公效率等</p></div><div class="card" @click="$router.push('/media-tools')"><h3 class="name"><span class="emoji-icon">🎨</span>办公/媒体</h3><p class="desc">图片、视频、音乐工具</p></div><div class="card" @click="$router.push('/study')"><h3 class="name"><span class="emoji-icon">📚</span>学习</h3><p class="desc">在线阅读、知识库、英语</p></div><div class="card" @click="$router.push('/free-vip')"><h3 class="name"><span class="emoji-icon">🎁</span>白嫖会员</h3><p class="desc">免费获取各类APP会员</p></div><div class="card" @click="$router.push('/paid-api')"><h3 class="name"><span class="emoji-icon">🔑</span>AI聚合站</h3><p class="desc">国内外热门AI免费使用</p></div></div></div>`
  };

  const createListPage = (title, desc, filterFn, parentLabel, parentPath) => ({
    setup() {
      const selectedTag = ref('');
      const items = computed(() => globalTools.value.filter(filterFn));
      const tags = computed(() => { const s = new Set(items.value.map(i => i.tag)); return ['全部', ...s]; });
      const filtered = computed(() => (!selectedTag.value || selectedTag.value === '全部') ? items.value : items.value.filter(i => i.tag === selectedTag.value));
      return { title, desc, parentLabel, parentPath, selectedTag, tags, filtered, getFaviconUrl, handleFaviconError, getSiteColor, handleStar, isStarred };
    },
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><router-link v-if="parentPath" :to="parentPath">{{parentLabel}}</router-link><span v-if="parentPath">/</span><span class="breadcrumb-title">{{title}}</span></div><div style="height:24px"></div><p class="page-desc">{{desc}}</p><div class="tag-filter" v-if="tags.length>2"><span class="filter-label">标签：</span><button v-for="t in tags" :key="t" @click="selectedTag=t" :class="{active:selectedTag===t}" class="tag-btn">{{t}}</button></div><div class="grid"><a v-for="item in filtered" :key="item.id" :href="item.url" target="_blank" class="card"><div class="card-header"><img v-if="!item.__faviconFailed" :src="getFaviconUrl(item.domain||item.url)" class="card-favicon" @error="handleFaviconError($event,item)"/><div v-else class="card-favicon-fallback" :style="{background:getSiteColor(item)}">{{ (item.name||'?')[0] }}</div><h3 class="name">{{item.name}}</h3></div><p class="desc">{{item.desc}}</p><div class="meta"><span class="tag">{{item.tag}}</span><button class="star-btn" :class="{starred:isStarred(item)}" @click.stop.prevent="handleStar(item)">⭐ {{item.stars_count||0}}</button><span class="domain">{{item.domain}}</span></div></a></div></div>`
  });

  const AINav = createListPage('AI导航站', 'AI工具导航聚合', t => t.category === 'ai-nav', null, null);
  const Study = createListPage('学习资源', '在线阅读、知识库、英语学习', t => t.category === 'study', null, null);
  const FreeVip = createListPage('白嫖APP会员', '免费获取各类APP会员', t => t.category === 'free-vip', null, null);

  const AITools = {
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><span class="breadcrumb-title">AI工具</span></div><div style="height:24px"></div><div class="grid"><div class="card" @click="$router.push('/ai-tools/resume')"><h3 class="name"><span class="emoji-icon">📄</span>AI简历</h3><p class="desc">智能简历生成</p></div><div class="card" @click="$router.push('/ai-tools/paper')"><h3 class="name"><span class="emoji-icon">📝</span>AI论文</h3><p class="desc">论文写作辅助</p></div><div class="card" @click="$router.push('/ai-tools/office')"><h3 class="name"><span class="emoji-icon">💼</span>AI办公</h3><p class="desc">文档PPT生成</p></div><div class="card" @click="$router.push('/ai-tools/prompt')"><h3 class="name"><span class="emoji-icon">💬</span>AI提示词</h3><p class="desc">提示词模板</p></div><div class="card" @click="$router.push('/ai-tools/learning')"><h3 class="name"><span class="emoji-icon">🎓</span>AI学习助手</h3><p class="desc">AI学习辅助</p></div><div class="card" @click="$router.push('/ai-tools/video')"><h3 class="name"><span class="emoji-icon">🎥</span>AI视频</h3><p class="desc">AI视频生成工具</p></div></div></div>`
  };

  const AIResume = createListPage('AI简历', '智能简历生成与优化', t => t.category==='ai-tools'&&t.subCategory==='resume', 'AI工具', '/ai-tools');
  const AIPaper = createListPage('AI论文', '论文查重降重文献检索', t => t.category==='ai-tools'&&t.subCategory==='paper', 'AI工具', '/ai-tools');
  const AIOffice = createListPage('AI办公', '文档/PPT生成', t => t.category==='ai-tools'&&t.subCategory==='office', 'AI工具', '/ai-tools');
  const AIPrompt = createListPage('AI提示词', '提示词模板库', t => t.category==='ai-tools'&&t.subCategory==='prompt', 'AI工具', '/ai-tools');
  const AILearning = createListPage('AI学习助手', 'AI学习辅助', t => t.category==='ai-tools'&&t.subCategory==='learning', 'AI工具', '/ai-tools');
  const AIVideo = createListPage('AI视频', 'AI视频生成工具', t => t.category==='ai-tools'&&t.subCategory==='video', 'AI工具', '/ai-tools');

  const MediaTools = {
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><span class="breadcrumb-title">办公/媒体工具</span></div><div style="height:24px"></div><div class="grid"><div class="card" @click="$router.push('/media-tools/office')"><h3 class="name"><span class="emoji-icon">📁</span>办公工具</h3><p class="desc">文件转换、思维导图等</p></div><div class="card" @click="$router.push('/media-tools/image')"><h3 class="name"><span class="emoji-icon">🖼️</span>图片工具</h3><p class="desc">图片拼接、修复、PS</p></div><div class="card" @click="$router.push('/media-tools/video')"><h3 class="name"><span class="emoji-icon">🎬</span>视频工具</h3><p class="desc">下载、转换、去水印</p></div><div class="card" @click="$router.push('/media-tools/music')"><h3 class="name"><span class="emoji-icon">🎵</span>音乐工具</h3><p class="desc">音效素材、免费音乐</p></div></div></div>`
  };
  const MediaOffice = createListPage('办公工具', '文件转换、思维导图、编辑', t => t.category==='media-tools'&&t.subCategory==='office', '办公/媒体', '/media-tools');
  const MediaImage = createListPage('图片工具', '图片拼接、修复、PS', t => t.category==='media-tools'&&t.subCategory==='image', '办公/媒体', '/media-tools');
  const MediaVideo = {
    setup() {
      const selectedTag = ref('');
      const items = computed(() => globalTools.value.filter(t => t.category==='media-tools'&&t.subCategory==='video'));
      const tags = computed(() => { const s = new Set(items.value.map(i => i.tag)); return ['全部', ...s]; });
      const filtered = computed(() => (!selectedTag.value || selectedTag.value === '全部') ? items.value : items.value.filter(i => i.tag === selectedTag.value));
      return { selectedTag, tags, filtered, getFaviconUrl, handleFaviconError, getSiteColor, handleStar, isStarred };
    },
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><router-link to="/media-tools">办公/媒体</router-link><span>/</span><span class="breadcrumb-title">视频工具</span></div><div style="height:24px"></div><p class="page-desc">视频下载、转换、去水印、字幕</p><div class="tag-filter" v-if="tags.length>2"><span class="filter-label">标签：</span><button v-for="t in tags" :key="t" @click="selectedTag=t" :class="{active:selectedTag===t}" class="tag-btn">{{t}}</button></div><div class="grid"><div class="card" @click="$router.push('/media-tools/material-hub')"><h3 class="name"><span class="emoji-icon">✂️</span>剪辑视频素材库</h3><p class="desc">视频素材1、视频素材2、剪辑屋</p></div><a v-for="item in filtered" :key="item.id" :href="item.url" target="_blank" class="card"><div class="card-header"><img v-if="!item.__faviconFailed" :src="getFaviconUrl(item.domain||item.url)" class="card-favicon" @error="handleFaviconError($event,item)"/><div v-else class="card-favicon-fallback" :style="{background:getSiteColor(item)}">{{ (item.name||'?')[0] }}</div><h3 class="name">{{item.name}}</h3></div><p class="desc">{{item.desc}}</p><div class="meta"><span class="tag">{{item.tag}}</span><button class="star-btn" :class="{starred:isStarred(item)}" @click.stop.prevent="handleStar(item)">⭐ {{item.stars_count||0}}</button><span class="domain">{{item.domain}}</span></div></a></div></div>`
  };
  const MediaMusic = createListPage('音乐工具', '音效素材、免费音乐平台', t => t.category==='media-tools'&&t.subCategory==='music', '办公/媒体', '/media-tools');
  const MediaMaterialHub = createListPage('剪辑视频素材库', '视频素材资源合集', t => t.category==='media-tools'&&t.subCategory==='material-hub', '办公/媒体', '/media-tools');

  // 全局 showPayModal 控制（供子组件调用）
  const globalShowPayModal = ref(false);

  // 收藏夹页面（展示用户已star的工具）
  const Favorites = {
    setup() {
      const favoriteTools = computed(() => {
        if (!userStarredSet.value.size) return [];
        return globalTools.value.filter(t => userStarredSet.value.has(t.id));
      });
      return { favoriteTools, getFaviconUrl, handleFaviconError, getSiteColor, handleStar, isStarred };
    },
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><span class="breadcrumb-title">🏠 我的收藏</span></div><div style="height:24px"></div><p class="page-desc">你收藏的网站都在这里</p><div v-if="favoriteTools.length" class="grid"><a v-for="item in favoriteTools" :key="item.id" :href="item.url" target="_blank" class="card"><div class="card-header"><img v-if="!item.__faviconFailed" :src="getFaviconUrl(item.domain||item.url)" class="card-favicon" @error="handleFaviconError($event,item)"/><div v-else class="card-favicon-fallback" :style="{background:getSiteColor(item)}">{{ (item.name||\'?\')[0] }}</div><h3 class="name">{{item.name}}</h3></div><p class="desc">{{item.desc}}</p><div class="meta"><span class="tag">{{item.tag}}</span><button class="star-btn starred" @click.stop.prevent="handleStar(item)">⭐ {{item.stars_count||0}}</button><span class="domain">{{item.domain}}</span></div></a></div><div v-else style="text-align:center;padding:60px 0;color:var(--muted);"><p style="font-size:48px;margin-bottom:16px;">📭</p><p style="font-size:15px;">还没有收藏任何工具</p><p style="font-size:13px;margin-top:8px;">浏览工具并点击 ⭐ 即可收藏到这里</p></div></div>`
  };

  // 付费API页面
  const PaidApi = {
    setup() {
      const items = computed(() => globalTools.value.filter(t => t.category === 'paid-api'));
      const checkAndGo = async (item) => {
        const token = getToken();
        if (!token) { globalShowPayModal.value = true; return; }
        try {
          const resp = await fetch(`${API_BASE}/api/paid-api/check`, { headers: authHeaders() });
          const data = await resp.json();
          if (data.hasAccess) {
            window.open(item.url, '_blank');
          } else {
            globalShowPayModal.value = true;
          }
        } catch {
          globalShowPayModal.value = true;
        }
      };
      return { items, getFaviconUrl, handleFaviconError, getSiteColor, checkAndGo };
    },
    template: `<div><div class="breadcrumb"><router-link to="/">首页</router-link><span>/</span><span class="breadcrumb-title">🔑 AI聚合站</span></div><div style="height:24px"></div><p class="page-desc">1元解锁免费的AI聚合站</p><div class="grid"><div v-for="item in items" :key="item.id" class="card" @click="checkAndGo(item)"><div class="card-header"><img v-if="!item.__faviconFailed" :src="getFaviconUrl(item.domain||item.url)" class="card-favicon" @error="handleFaviconError($event,item)"/><div v-else class="card-favicon-fallback" :style="{background:getSiteColor(item)}">{{ (item.name||'?')[0] }}</div><h3 class="name">{{item.name}}</h3></div><p class="desc">{{item.desc}}</p><div class="meta"><span class="tag">{{item.tag}}</span><span class="tag" style="background:var(--brand);color:#fff;border-color:var(--brand);">点击访问</span></div></div></div></div>`
  };

  // 路由
  const router = createRouter({ history: createWebHashHistory(), routes: [
    { path: '/', component: Home },
    { path: '/ai-nav', component: AINav },
    { path: '/ai-tools', component: AITools },
    { path: '/ai-tools/resume', component: AIResume },
    { path: '/ai-tools/paper', component: AIPaper },
    { path: '/ai-tools/office', component: AIOffice },
    { path: '/ai-tools/prompt', component: AIPrompt },
    { path: '/ai-tools/learning', component: AILearning },
    { path: '/ai-tools/video', component: AIVideo },
    { path: '/media-tools', component: MediaTools },
    { path: '/media-tools/office', component: MediaOffice },
    { path: '/media-tools/image', component: MediaImage },
    { path: '/media-tools/video', component: MediaVideo },
    { path: '/media-tools/music', component: MediaMusic },
    { path: '/media-tools/material-hub', component: MediaMaterialHub },
    { path: '/study', component: Study },
    { path: '/free-vip', component: FreeVip },
    { path: '/paid-api', component: PaidApi },
    { path: '/favorites', component: Favorites }
  ]});

  const app = createApp({
    setup() {
      const feedbackText = ref('');
      const contactInfo = ref('');

      const updateNickname = async () => {
        nicknameMsg.value = ''; nicknameErr.value = '';
        const nn = newNickname.value.trim();
        if (nn.length < 2 || nn.length > 20) { nicknameErr.value = '昵称长度需2-20个字符'; return; }
        try {
          const resp = await fetch(`${API_BASE}/api/profile/nickname`, {
            method: 'POST', headers: authHeaders(), body: JSON.stringify({ nickname: nn })
          });
          const data = await resp.json();
          if (resp.ok) {
            nicknameMsg.value = '昵称修改成功';
            currentUser.value.nickname = nn;
            localStorage.setItem('user', JSON.stringify(currentUser.value));
            setTimeout(() => { showNicknameModal.value = false; nicknameMsg.value = ''; }, 1000);
          } else {
            nicknameErr.value = data.error || '修改失败';
          }
        } catch {
          nicknameErr.value = '网络错误';
        }
      };

      const openAvatarModal = async () => {
        showAvatarModal.value = true;
        if (presetAvatars.value.length === 0) {
          try {
            const resp = await fetch(`${API_BASE}/api/avatars`);
            const data = await resp.json();
            presetAvatars.value = data.avatars || [];
          } catch { presetAvatars.value = []; }
        }
      };

      const closeAvatarModal = () => {
        showAvatarModal.value = false;
        selectedPreset.value = '';
        avatarMsg.value = '';
        avatarErr.value = '';
      };

      const handleAvatarFile = async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        if (file.size > 2 * 1024 * 1024) { avatarErr.value = '图片不能超过2MB'; return; }
        uploadingAvatar.value = true; avatarErr.value = ''; avatarMsg.value = '';
        const formData = new FormData();
        formData.append('avatar', file);
        try {
          const resp = await fetch(`${API_BASE}/api/avatar/upload`, {
            method: 'POST', headers: { 'Authorization': `Bearer ${getToken()}` }, body: formData
          });
          const data = await resp.json();
          if (resp.ok) {
            currentUser.value.avatar = data.avatar;
            localStorage.setItem('user', JSON.stringify(currentUser.value));
            avatarMsg.value = '头像上传成功';
            setTimeout(() => { closeAvatarModal(); }, 1000);
          } else {
            avatarErr.value = data.error || '上传失败';
          }
        } catch {
          avatarErr.value = '网络错误';
        }
        uploadingAvatar.value = false;
      };

      const selectPresetAvatar = async (av) => {
        selectedPreset.value = av; avatarErr.value = ''; avatarMsg.value = '';
        try {
          const resp = await fetch(`${API_BASE}/api/avatar`, {
            method: 'POST', headers: authHeaders(), body: JSON.stringify({ avatar: av })
          });
          const data = await resp.json();
          if (resp.ok) {
            currentUser.value.avatar = av;
            localStorage.setItem('user', JSON.stringify(currentUser.value));
            avatarMsg.value = '头像已更新';
            setTimeout(() => { closeAvatarModal(); }, 1000);
          } else {
            avatarErr.value = data.error || '保存失败';
          }
        } catch {
          avatarErr.value = '网络错误';
        }
      };

      const isDarkMode = ref(false);
      const isSending = ref(false);
      const isSubmitDisabled = ref(false);
      const showNicknameModal = ref(false);
      const newNickname = ref('');
      const nicknameMsg = ref('');
      const nicknameErr = ref('');
      const showAvatarModal = ref(false);
      const presetAvatars = ref([]);
      const selectedPreset = ref('');
      const uploadingAvatar = ref(false);
      const avatarMsg = ref('');
      const avatarErr = ref('');
      const showQrModal = ref(false);
      const showPayModal = globalShowPayModal;
      const showNotice = ref(false);
      const noticeDontShow = ref(false);
      const searchQuery = ref('');
      const searchResults = computed(() => {
        const q = searchQuery.value.trim().toLowerCase();
        if (!q) return [];
        return globalTools.value.filter(t => t.name?.toLowerCase().includes(q) || t.desc?.toLowerCase().includes(q) || t.tag?.toLowerCase().includes(q));
      });
      const totalTools = computed(() => globalTools.value.length);

      const closeNotice = () => {
        showNotice.value = false;
        if (noticeDontShow.value) { localStorage.setItem('noticeDismissed', '1'); }
      };

      const toggleDarkMode = () => {
        isDarkMode.value = !isDarkMode.value;
        document.body.setAttribute('data-theme', isDarkMode.value ? 'dark' : 'light');
        localStorage.setItem('theme', isDarkMode.value ? 'dark' : 'light');
      };

      const paidSubmitting = ref(false);
      const paidMsg = ref('');
      const paidMsgOk = ref(false);
      const paidWechatName = ref('');
      const paidWechatId = ref('');

      const handlePaidConfirm = async () => {
        if (!currentUser.value) {
          paidMsg.value = '请先登录后再操作';
          paidMsgOk.value = false;
          return;
        }
        if (!paidWechatName.value.trim() || !paidWechatId.value.trim()) {
          paidMsg.value = '请填写微信昵称和微信号';
          paidMsgOk.value = false;
          return;
        }
        paidSubmitting.value = true;
        paidMsg.value = '';
        try {
          const resp = await fetch(`${API_BASE}/api/paid-api/apply`, {
            method: 'POST',
            headers: authHeaders(),
            body: JSON.stringify({ wechat_name: paidWechatName.value, wechat_id: paidWechatId.value })
          });
          const data = await resp.json();
          if (resp.ok) {
            paidMsg.value = '申请已提交！站长收到后会尽快为您开通，请稍后刷新重试。';
            paidMsgOk.value = true;
            paidWechatName.value = '';
            paidWechatId.value = '';
          } else {
            paidMsg.value = data.error || '提交失败，请直接联系站长QQ：2477099183';
            paidMsgOk.value = false;
          }
        } catch (e) {
          paidMsg.value = '网络错误，请直接联系站长QQ：2477099183';
          paidMsgOk.value = false;
        }
        paidSubmitting.value = false;
      };

      const submitFeedback = async () => {
        if (!contactInfo.value.trim() || !feedbackText.value.trim()) {
          setUiMessage('请填写联系方式和推荐内容', 'error-msg'); return;
        }
        isSending.value = true;
        try {
          const resp = await fetch(`${API_BASE}/api/send-email`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ from_name: contactInfo.value, message: feedbackText.value, subject: `【工具推荐】来自 ${contactInfo.value}` })
          });
          if (resp.ok) {
            setUiMessage('提交成功，感谢推荐！', 'success-msg');
            feedbackText.value = ''; contactInfo.value = '';
            isSubmitDisabled.value = true;
            setTimeout(() => (isSubmitDisabled.value = false), 30000);
          } else {
            setUiMessage('提交失败，请直接发邮件', 'error-msg');
          }
        } catch (e) {
          setUiMessage('提交失败，请直接发邮件', 'error-msg');
        }
        isSending.value = false;
      };

      const loadTools = async () => {
        try {
          const resp = await fetch('tools.json');
          if (!resp.ok) throw new Error('load failed');
          const data = await resp.json();
          globalTools.value = (data.tools || []).map(t => ({ __faviconFailed: false, stars_count: 0, ...t }));
        } catch {
          globalTools.value = [];
        }
        await syncStarsFromBackend();
        await loadMyStars();
      };

      onMounted(() => {
        // 游客模式
        if (window.location.search.includes('guest=1')) {
          isGuest.value = true;
          document.body.setAttribute('data-guest', 'true');
          const saved = localStorage.getItem('theme');
          if (saved === 'dark') { isDarkMode.value = true; document.body.setAttribute('data-theme', 'dark'); }
          loadTools();
          return;
        }
        // 未登录直接重定向到登录页
        const token = getToken();
        const userStr = localStorage.getItem("user");
        if (!token || !userStr) { window.location.href = "login.html"; return; }
        // 恢复主题
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') { isDarkMode.value = true; document.body.setAttribute('data-theme', 'dark'); }
        // 检查登录
        if (token && userStr) { try { currentUser.value = JSON.parse(userStr); } catch {} }
        if (token) { fetch(`${API_BASE}/api/me`,{headers:authHeaders()}).then(r=>r.ok?r.json():null).then(d=>{if(d&&d.user){currentUser.value=d.user;localStorage.setItem(`user`,JSON.stringify(d.user));}}).catch(()=>{}); }
        if (currentUser.value && localStorage.getItem('noticeDismissed') !== '1') { showNotice.value = true; }
        loadTools();
      });

      return {
        feedbackText, contactInfo, isDarkMode, isSending, isSubmitDisabled,
        showNicknameModal, newNickname, nicknameMsg, nicknameErr, showAvatarModal, presetAvatars, selectedPreset, uploadingAvatar, avatarMsg, avatarErr, showQrModal, updateNickname, openAvatarModal, closeAvatarModal, handleAvatarFile, selectPresetAvatar, showPayModal, totalTools, currentUser, sendMessage, sendStatusClass, shareCopied, copyShareLink, isGuest,
        showNotice, noticeDontShow, closeNotice,
        searchQuery, searchResults, getFaviconUrl, handleFaviconError, getSiteColor,
        toggleDarkMode, submitFeedback, logout, handlePaidConfirm,
        paidSubmitting, paidMsg, paidMsgOk, paidWechatName, paidWechatId
      };
    }
  });
  app.use(router);
  app.mount('#app');
</script>

<!-- 深色模式 3D 星空动效 -->
<script>
(function() {
  const canvas = document.getElementById('dark-particle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let stars = [];
  let shootingStars = [];
  let animId = null;
  let isRunning = false;
  let centerX, centerY, focalLength;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    centerX = canvas.width / 2;
    centerY = canvas.height / 2;
    focalLength = Math.max(canvas.width, canvas.height) * 0.8;
  }

  // 3D 星星：z 轴分布产生纵深透视
  class Star {
    constructor() { this.reset(true); }
    reset(initial) {
      this.x = (Math.random() - 0.5) * 2000;
      this.y = (Math.random() - 0.5) * 2000;
      this.z = initial ? Math.random() * 1500 + 200 : 1500 + Math.random() * 200;
      this.baseSize = Math.random() * 1.2 + 0.3;
      this.twinklePhase = Math.random() * Math.PI * 2;
      this.twinkleSpeed = Math.random() * 0.03 + 0.008;
      // 颜色：白、淡蓝、淡紫、淡黄 — 真实星空色
      const roll = Math.random();
      if (roll < 0.55) { this.r = 220 + Math.random()*35; this.g = 225 + Math.random()*30; this.b = 255; }
      else if (roll < 0.75) { this.r = 180 + Math.random()*40; this.g = 200 + Math.random()*30; this.b = 255; }
      else if (roll < 0.88) { this.r = 255; this.g = 240 + Math.random()*15; this.b = 200 + Math.random()*30; }
      else { this.r = 200 + Math.random()*55; this.g = 180 + Math.random()*40; this.b = 255; }
      this.speed = Math.random() * 0.8 + 0.15;
    }
    update() {
      this.z -= this.speed;
      this.twinklePhase += this.twinkleSpeed;
      if (this.z <= 1) this.reset(false);
    }
    draw() {
      const scale = focalLength / this.z;
      const sx = centerX + this.x * scale;
      const sy = centerY + this.y * scale;
      if (sx < -50 || sx > canvas.width + 50 || sy < -50 || sy > canvas.height + 50) return;
      const depthFactor = 1 - this.z / 1700;
      const size = this.baseSize * scale * 0.8;
      const twinkle = 0.5 + 0.5 * Math.sin(this.twinklePhase);
      const alpha = Math.min(1, depthFactor * 0.9 * twinkle + 0.1);
      if (size > 1.5) {
        const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, size * 3);
        glow.addColorStop(0, `rgba(${this.r|0},${this.g|0},${this.b|0},${alpha})`);
        glow.addColorStop(0.4, `rgba(${this.r|0},${this.g|0},${this.b|0},${alpha*0.3})`);
        glow.addColorStop(1, `rgba(${this.r|0},${this.g|0},${this.b|0},0)`);
        ctx.fillStyle = glow;
        ctx.beginPath();
        ctx.arc(sx, sy, size * 3, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = `rgba(${this.r|0},${this.g|0},${this.b|0},${alpha})`;
      ctx.beginPath();
      ctx.arc(sx, sy, Math.max(size, 0.4), 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // 流星
  class ShootingStar {
    constructor() { this.active = false; }
    spawn() {
      this.active = true;
      this.x = Math.random() * canvas.width * 0.8 + canvas.width * 0.1;
      this.y = Math.random() * canvas.height * 0.3;
      this.angle = Math.PI / 4 + (Math.random() - 0.5) * 0.5;
      this.speed = 6 + Math.random() * 8;
      this.len = 60 + Math.random() * 80;
      this.life = 0;
      this.maxLife = 40 + Math.random() * 30;
    }
    update() {
      if (!this.active) return;
      this.x += Math.cos(this.angle) * this.speed;
      this.y += Math.sin(this.angle) * this.speed;
      this.life++;
      if (this.life > this.maxLife) this.active = false;
    }
    draw() {
      if (!this.active) return;
      const progress = this.life / this.maxLife;
      const alpha = 1 - progress;
      const tailX = this.x - Math.cos(this.angle) * this.len * (1 - progress);
      const tailY = this.y - Math.sin(this.angle) * this.len * (1 - progress);
      const grad = ctx.createLinearGradient(this.x, this.y, tailX, tailY);
      grad.addColorStop(0, `rgba(255,255,255,${alpha})`);
      grad.addColorStop(1, 'rgba(150,180,255,0)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.5;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(this.x, this.y);
      ctx.lineTo(tailX, tailY);
      ctx.stroke();
    }
  }

  function initStars() {
    const count = Math.min(Math.floor((canvas.width * canvas.height) / 1800), 800);
    stars = [];
    for (let i = 0; i < count; i++) stars.push(new Star());
    shootingStars = [];
    for (let i = 0; i < 5; i++) shootingStars.push(new ShootingStar());
  }

  let frameCount = 0;
  function animate() {
    if (!isRunning) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    // 深空微渐变
    const bgGrad = ctx.createRadialGradient(centerX, centerY * 0.6, 0, centerX, centerY, Math.max(canvas.width, canvas.height) * 0.7);
    bgGrad.addColorStop(0, 'rgba(15, 20, 40, 0.02)');
    bgGrad.addColorStop(1, 'rgba(5, 5, 15, 0.04)');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    stars.forEach(s => { s.update(); s.draw(); });

    // 流星随机触发
    frameCount++;
    if (frameCount % 100 === 0 && Math.random() < 0.5) {
      const idle = shootingStars.find(s => !s.active);
      if (idle) idle.spawn();
    }
    shootingStars.forEach(s => { s.update(); s.draw(); });
    animId = requestAnimationFrame(animate);
  }

  function start() {
    if (isRunning) return;
    isRunning = true;
    resize();
    initStars();
    animate();
  }

  function stop() {
    isRunning = false;
    if (animId) { cancelAnimationFrame(animId); animId = null; }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }

  const observer = new MutationObserver(() => {
    const theme = document.body.getAttribute('data-theme');
    if (theme === 'dark') start();
    else stop();
  });
  observer.observe(document.body, { attributes: true, attributeFilter: ['data-theme'] });

  window.addEventListener('resize', () => {
    if (!isRunning) return;
    resize();
    initStars();
  });

  // 初始如果已是深色模式则启动
  if (document.body.getAttribute('data-theme') === 'dark') start();
})();
</script>
</body>
</html>
